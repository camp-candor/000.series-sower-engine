{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "rootDir": ".",
        "outDir": "./dist",
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node", "vitest/globals"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
