{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "../dist/300.engine",
        "rootDir": ".",
        "tsBuildInfoFile": "../dist/300.engine/.tsbuildinfo",
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["**/*"],
    "exclude": ["node_modules", "../dist", "**/*.spec.ts", "test/**/*"]
}
