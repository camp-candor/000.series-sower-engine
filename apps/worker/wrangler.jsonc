{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "worker-sower-engine",
    "main": "src/index.ts",
    "compatibility_date": "2024-11-01",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            {
                "name": "SOWER_SESSION",
                "class_name": "SowerSessionDO",
            },
        ],
    },
    "d1_databases": [
        {
            "binding": "CANON_DB",
            "database_name": "series-canon-db",
            "database_id": "series-canon-db-id",
        },
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["SowerSessionDO"],
        },
    ],
    "observability": {
        "enabled": true,
    },
}
